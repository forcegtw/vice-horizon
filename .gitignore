# Dependencies (never commit the installs)
node_modules/
.pnp
.pnp.js

# Packaging / build output — main.ts writes to MAKEFUN_OUTPUT_DIR, /output by default.
out/
dist/
build/
.next/
.nuxt/

# Logs and pid files
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (secrets stay out of history)
.env
.env.local
.env.*.local

# Editor and OS debris
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test and tooling artifacts
coverage/
.eslintcache
.nyc_output
*.tmp
